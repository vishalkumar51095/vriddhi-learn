# Copy to .env (never commit it) and fill in real values.

# Generate with:  openssl rand -base64 48
JWT_SECRET=
# Generate with:  openssl rand -base64 24
DB_PASSWORD=

# ":80" = plain HTTP on the server's IP. For HTTPS put your domain here, e.g. vriddhi.duckdns.org
# (its DNS must already point at this server, and ports 80 + 443 must be open).
SITE_ADDRESS=:80
